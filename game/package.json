{
  "name": "sandstone-kingdom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sandstone Kingdom: Tower Defense. A tower defense game set in medieval India.",
  "scripts": {
    "serve": "python3 -m http.server 8090",
    "test": "node --test test/*.test.js",
    "devices": "node test/devices.mjs",
    "build:web": "node scripts/build-web.mjs",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "cordova-plugin-purchase": "^13.20.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@fontsource/martel": "^5.3.0",
    "@fontsource/rozha-one": "^5.3.0"
  }
}
