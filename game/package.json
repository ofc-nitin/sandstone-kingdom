{
  "name": "gravity-flip-sort",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tilt the board, sort the balls. A mobile web puzzle game.",
  "scripts": {
    "levels": "node tools/generate-levels.js",
    "test": "node --test test/*.test.js",
    "serve": "python3 -m http.server 8080",
    "build": "node tools/build-web.js",
    "sync": "node tools/build-web.js && npx cap sync android",
    "e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
